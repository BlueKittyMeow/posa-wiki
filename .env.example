# Posa Wiki environment configuration.
#
# Copy to .env and fill in real values. .env is gitignored -- never commit it.
# Everything here is optional in development; the defaults in config.py are
# development-safe. Production refuses to start without FLASK_SECRET_KEY.

# ---------------------------------------------------------------------------
# Environment selection
# ---------------------------------------------------------------------------
# One of: development | production | testing  (default: development)
POSA_WIKI_ENV=development

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# Session / CSRF signing key. REQUIRED in production -- startup fails if this is
# still the built-in 'dev-secret-change-me'. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=

# Signing key for API JWTs. Defaults to FLASK_SECRET_KEY (logs a warning in
# production). Use a separate value so rotating one doesn't invalidate the other.
JWT_SECRET_KEY=

# Token lifetimes
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Absolute or relative path to the SQLite file (default: ./posa_wiki.db)
DATABASE_PATH=posa_wiki.db

# ---------------------------------------------------------------------------
# Pagination
# ---------------------------------------------------------------------------
VIDEOS_PER_PAGE=24
PEOPLE_PER_PAGE=20
DOGS_PER_PAGE=20
SERIES_PER_PAGE=20
TRIPS_PER_PAGE=20

# ---------------------------------------------------------------------------
# Cookies
# ---------------------------------------------------------------------------
SESSION_COOKIE_SAMESITE=Lax

# ---------------------------------------------------------------------------
# Rate limiting (Flask-Limiter)
# ---------------------------------------------------------------------------
RATELIMIT_ENABLED=true

# Global default limit applied to every route. Empty = no global limit, which
# is the default: individual sensitive routes set their own (login is 5/minute).
# Only set this if you really want a site-wide cap, e.g. '200 per day;50 per hour'.
RATELIMIT_DEFAULT=

# Storage backend for limit counters. Empty = in-memory (per-process, resets on
# restart; fine for single-process dev). Use redis://... in production.
RATELIMIT_STORAGE_URI=

# ---------------------------------------------------------------------------
# Redis (JWT revocation blocklist + rate limit storage)
# ---------------------------------------------------------------------------
# Disabled by default in development; forced on in production config.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Reverse proxy
# ---------------------------------------------------------------------------
# Set to 1 ONLY when the app sits behind a trusted reverse proxy (cloudflared,
# nginx). It makes Flask honour X-Forwarded-For/-Proto so per-IP rate limiting
# and audit logs see the real client instead of 127.0.0.1.
# Leave unset when the app is directly exposed -- otherwise clients can spoof
# their IP via a forged X-Forwarded-For header.
PROXY_FIX=0
